{
  "name": "@crypto-elements/core",
  "version": "0.1.0",
  "description": "Framework-agnostic SVG logos for crypto chains, DEXes and protocols",
  "keywords": ["crypto", "icons", "logos", "svg", "defi", "dex", "blockchain", "ethereum", "solana"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/shakdaniel/crypto-elements.git", "directory": "packages/core" },
  "homepage": "https://shakdaniel.github.io/crypto-elements",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "devDependencies": { "tsup": "^8.3.5", "typescript": "^5.6.3" }
}
