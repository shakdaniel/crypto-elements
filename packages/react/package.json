{
  "name": "@shakdaniel/react",
  "version": "0.1.0",
  "description": "React components for crypto chain, DEX and protocol logos",
  "keywords": ["react", "crypto", "icons", "logos", "svg", "defi", "dex", "blockchain"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/shakdaniel/crypto-elements.git", "directory": "packages/react" },
  "homepage": "https://shakdaniel.github.io/crypto-elements",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
